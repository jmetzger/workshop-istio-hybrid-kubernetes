   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Cluster a: workload certificates, time until they expire",
   "description": "A healthy workload shows a saw: the line falls, the agent renews the certificate, the line jumps up. A line that falls to zero is a certificate that nobody renews.",
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-a"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-a"
     },
     "expr": "istio_agent_cert_expiry_seconds",
     "legendFormat": "{{pod}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
